---
import '../styles/global.css';
const {title='FRENCHUG — собственный код. Математика риска.', description='Ярослав Алексеевич. Алгоритмический трейдинг, собственная торговая система и разборы сделок в Telegram.', noindex=false}=Astro.props;
const base=import.meta.env.BASE_URL;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#050505"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="ru_RU"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(`${base}og.svg`,Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/>{noindex&&<meta name="robots" content="noindex,follow"/>}</head>
<body><a class="skip" href="#main">К содержанию</a><div class="scroll-progress" aria-hidden="true"></div>
<header class="header"><a href={base} class="logo" aria-label="FRENCHUG — главная"><svg width="24" height="28" viewBox="0 0 24 28" aria-hidden="true"><path d="M5 1h19l-2 7H11l-1 4h10l-2 7H8l-2 8H0Z" fill="currentColor"/></svg>frenchug<span class="logo-dot">®</span></a>
<nav class="desktop-nav" aria-label="Основная навигация"><a href={`${base}#approach`}>Подход</a><a href={`${base}stats/`}>Статистика</a><a href={`${base}signals/`}>Сигналы <span class="nav-dot"></span></a></nav>
<a class="header-tg" href="https://t.me/frenchug" target="_blank" rel="noopener noreferrer" data-track="telegram_header">Мой Telegram <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8" fill="none"/></svg></a><button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></header>
<nav id="mobile-nav" class="mobile-nav" aria-label="Мобильная навигация" hidden><a href={`${base}#approach`}>Подход</a><a href={`${base}stats/`}>Статистика</a><a href={`${base}signals/`}>Сигналы</a><a href="https://t.me/frenchug" target="_blank" rel="noopener noreferrer">Мой Telegram ↗</a></nav>
<main id="main"><slot /></main>
<footer class="footer"><div class="footer-top"><a class="logo" href={base}>frenchug®</a><span>Собственный код. Собственные решения.</span><a href="#main" aria-label="Вернуться наверх">Наверх ↑</a></div><p class="risk-note">Торговля криптовалютами связана с риском потери капитала. Результаты прошлых сделок не гарантируют будущую доходность. Материалы проекта носят информационный характер. 18+.</p><div class="footer-bottom"><span>© {new Date().getFullYear()} FRENCHUG</span><div><a href={`${base}terms/`}>Условия</a><a href={`${base}privacy/`}>Конфиденциальность</a><a href={`${base}subscription/`}>Подписка</a><a href={`${base}risks/`}>Риски</a></div></div></footer>
<script>import '../scripts/main';</script></body></html>
