---
const {class: className = ''}=Astro.props;
---
<div class:list={['sculpture',className]} aria-hidden="true">
  <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
  <div class="f-object"><div class="f-depth"></div><div class="f-face"><span></span></div></div>
  <div class="metal-chip chip-one"><span>＋</span></div><div class="metal-chip chip-two"><span>×</span></div>
  <div class="spark spark-one">✦</div><div class="spark spark-two">✦</div>
</div>
