---
interface Props {
  file: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
}

const { file, width, height, alt, caption } = Astro.props;
const src = `${import.meta.env.BASE_URL}visuals/trades/${file}.jpg`;
---

<a class="trade-screenshot" href={src} target="_blank" rel="noopener" aria-label={`${caption}. Открыть скриншот в полном размере в новой вкладке`}>
  <img src={src} {width} {height} {alt} loading="lazy" decoding="async" />
  <span class="trade-caption">
    {caption}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 17 17 7M7 7h10v10" fill="none" stroke="currentColor" stroke-width="1.8" />
    </svg>
  </span>
</a>

<style>
  .trade-screenshot {
    display: block;
    border: 1px solid #3b3038;
    border-radius: clamp(12px, 1.4vw, 22px);
    background: #141114;
    color: #fff;
    box-shadow: 0 14px 28px #0004;
  }

  .trade-screenshot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(11px, 1.35vw, 21px) clamp(11px, 1.35vw, 21px) 0 0;
  }

  .trade-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px clamp(10px, 1.25vw, 18px);
    font-size: clamp(13px, 1.15vw, 16px);
    line-height: 1.3;
  }

  .trade-caption svg {
    width: 20px;
    height: 20px;
    flex: none;
    color: #fac5d0;
  }

  .trade-screenshot:hover .trade-caption {
    color: #fac5d0;
  }

  .trade-screenshot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
</style>
