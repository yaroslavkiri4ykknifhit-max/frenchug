---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import TradeScreenshot from '../components/TradeScreenshot.astro';
import data from '../data/stats.json';
const base=import.meta.env.BASE_URL;
// Fail closed: a verified publication needs methodology and an audited export.
if(data.verified) throw new Error('Verified statistics require a reviewed publication component. See docs/STATS.md.');

const chartColumns = [
  [
    { file: 'position-range', width: 1280, height: 1068, caption: 'Зоны риска и цели', alt: 'Свечной график с серой зоной риска, синей зоной цели и стрелками на свечах.' },
    { file: 'chart-levels', width: 1280, height: 617, caption: 'Уровни на графике', alt: 'Свечной график с горизонтальными уровнями и значениями в долларах справа.' },
  ],
  [
    { file: 'entry-exit', width: 828, height: 528, caption: 'Отметки покупки и продажи', alt: 'Тёмный свечной график с зелёной отметкой B и розовой отметкой S.' },
    { file: 'supertrend', width: 825, height: 577, caption: 'График с SuperTrend', alt: 'Свечной график с индикатором SuperTrend и отметками уровней цены.' },
  ],
];
---
<Layout title="Статистика FRENUGO — данные и методология" description="Как проверять результаты торговой системы FRENUGO: источник сделок, период, комиссии, просадки и методика расчёта.">
<section class="page-hero"><span class="small-label">Проверяемость важнее впечатления</span><h1>Цифры любят<br/>контекст.</h1><p>Доходность — только вместе с периодом, историей сделок и риском, который за ней стоит.</p></section>
<section class="section-pad" style="padding-top:0"><div class="empty-data"><span class="small-label">Подтверждённый журнал ещё не опубликован</span><h2>Здесь будет<br/>полная картина.</h2><p>Сейчас у сайта нет подтверждённой выгрузки сделок. Доля прибыльных сделок, график и доходность появятся после публикации журнала. Разборы подхода — в публичном канале.</p><div class="data-fields"><div><strong>—</strong><span>Доходность</span></div><div><strong>—</strong><span>Количество сделок</span></div><div><strong>—</strong><span>Доля прибыльных сделок</span></div><div><strong>—</strong><span>Максимальная просадка</span></div></div><Button href="https://t.me/frenchug" target="_blank" rel="noopener noreferrer" data-track="telegram_stats">Посмотреть канал</Button></div></section>
<section class="section-pad trade-gallery" aria-labelledby="trade-gallery-title">
  <h2 id="trade-gallery-title">Примеры графиков</h2>
  <p>Отдельные скриншоты с торговыми уровнями и отметками сделок.</p>
  <div class="trade-gallery-grid">
    {chartColumns.map(column => (
      <div class="trade-gallery-column">
        {column.map(chart => <TradeScreenshot {...chart} />)}
      </div>
    ))}
  </div>
</section>
<section class="section-pad" style="padding-top:20px"><h2>Что нужно<br/>для проверки.</h2><ol class="method-list"><li><strong>Источник и период</strong><p>Полная выгрузка из торгового аккаунта с датами и часовым поясом. Пополнения и выводы отделяются от торгового результата.</p></li><li><strong>Чистый результат</strong><p>Комиссии и финансирование указываются отдельно и учитываются при расчёте результата. Указывается валюта расчёта и способ оценки открытых позиций.</p></li><li><strong>Риск и просадка</strong><p>Максимальное снижение от предыдущего пика эквити. Балансовая просадка и просадка с учётом открытых позиций не смешиваются.</p></li><li><strong>Доля прибыльных сделок</strong><p>Долю считаем так: число прибыльных закрытых сделок делим на число всех закрытых сделок. Правила учёта частичных выходов и безубыточных сделок публикуются вместе с журналом.</p></li><li><strong>Реальная торговля и тесты</strong><p>Тесты на исторических данных, демосделки и реальные сделки публикуются раздельно. Результаты тестирования не выдаются за полученную прибыль.</p></li></ol></section>
<section class="section-pad signal-tease"><h2>Сначала понять.<br/>Потом решать.</h2><div style="margin-top:35px"><Button href={`${base}signals/`} kind="dark">Как устроены сигналы</Button></div></section>
</Layout>

<style>
  .trade-gallery {
    padding-top: 0;
  }

  .trade-gallery h2 {
    font-size: clamp(38px, 6vw, 92px);
  }

  .trade-gallery p {
    margin-top: 18px;
    color: var(--grey);
  }

  .trade-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 28px);
    margin-top: clamp(24px, 3vw, 40px);
  }

  .trade-gallery-column {
    display: grid;
    align-content: start;
    gap: inherit;
  }

  @media (max-width: 767px) {
    .trade-gallery-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
