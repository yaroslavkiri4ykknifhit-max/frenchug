---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="FRENCHUG — результаты и торговые сигналы" description="FRENCHUG: статистика сделок, результаты и доступ к торговым сигналам в Telegram.">
<div class="showcase-home">
  <section class="showcase-hero" id="top">
    <div class="showcase-hero-inner">
      <div class="showcase-eyebrow"><span class="sh-dot"></span> FRENCHUG / TRADING RESULTS <span>2026</span></div>
      <h1 class="showcase-title"><span class="st-line">ТОЛЬКО</span><span class="st-line">ЦИФРЫ<span class="st-period">.</span></span></h1>
      <div class="hero-coin coin-3d" aria-hidden="true"><div class="coin-face"><span>F</span></div></div>
      <div class="showcase-hero-foot"><span>РЕЗУЛЬТАТЫ. СИГНАЛЫ. TELEGRAM.</span><a href="#results" class="showcase-scroll" aria-label="К результатам">СКРОЛЛ <span>↓</span></a><a href="https://t.me/frenchug" target="_blank" rel="noopener noreferrer" class="showcase-pill" data-track="telegram_hero">TELEGRAM ↗</a></div>
    </div>
  </section>

  <section class="coin-parade" aria-label="Золотые монеты FRENCHUG">
    <div class="coin-parade-head"><span>FRENCHUG / 001</span><span>НЕ СЛОВА. ЦИФРЫ.</span></div>
    <div class="coin-row" aria-hidden="true">
      <div class="coin-3d coin-a"><div class="coin-face"><span>F</span></div></div>
      <div class="coin-3d coin-b"><div class="coin-face"><span>F</span></div></div>
      <div class="coin-3d coin-c"><div class="coin-face"><span>F</span></div></div>
      <div class="coin-3d coin-d"><div class="coin-face"><span>F</span></div></div>
      <div class="coin-3d coin-e"><div class="coin-face"><span>F</span></div></div>
    </div>
    <div class="coin-parade-bottom"><span>РЕЗУЛЬТАТ В ДВИЖЕНИИ</span><span>↓</span></div>
  </section>

  <section class="results-stage" id="results">
    <div class="showcase-section-top"><span>01 / РЕЗУЛЬТАТЫ</span><a href={base + 'stats/'}>СТАТИСТИКА ↗</a></div>
    <div class="results-label">PNL</div>
    <div class="results-number" aria-label="Исторический PNL плюс 4 619 долларов"><span>+</span>$4,619</div>
    <div class="result-coin result-coin-one coin-3d" aria-hidden="true"><div class="coin-face"><span>F</span></div></div>
    <div class="result-coin result-coin-two coin-3d" aria-hidden="true"><div class="coin-face"><span>F</span></div></div>
    <div class="result-coin result-coin-three coin-3d" aria-hidden="true"><div class="coin-face"><span>F</span></div></div>
    <div class="results-bottom"><div><span class="metric-label">WIN RATE</span><strong>44<span>%</span></strong></div><div><span class="metric-label">PERFORMANCE</span><strong>+4,619<span>$</span></strong></div></div>
    <p class="results-disclaimer">Исторические показатели по данным автора, независимо не подтверждены. Прошлые результаты не гарантируют будущую прибыль.</p>
  </section>

  <section class="gold-stage">
    <div class="showcase-section-top"><span>02 / FRENCHUG</span><span>NO NOISE</span></div>
    <div class="gold-type" aria-label="Результат">РЕЗУЛЬТАТ</div>
    <div class="gold-stage-foot"><span>ВМЕСТО ОБЕЩАНИЙ</span><span>—</span><span>СТАТИСТИКА.</span></div>
  </section>

  <section class="subscription-stage" id="subscription">
    <div class="showcase-section-top"><span>03 / ЗАКРЫТЫЙ TELEGRAM</span><span>30 ДНЕЙ ДОСТУПА</span></div>
    <h2 class="subscription-title">СИГНАЛЫ.</h2>
    <div class="subscription-price"><span class="dollar">$</span>73</div>
    <div class="subscription-coins" aria-hidden="true">
      <div class="coin-3d sub-coin-one"><div class="coin-face"><span>F</span></div></div>
      <div class="coin-3d sub-coin-two"><div class="coin-face"><span>F</span></div></div>
      <div class="coin-3d sub-coin-three"><div class="coin-face"><span>F</span></div></div>
    </div>
    <div class="subscription-foot"><span>$73 / 30 ДНЕЙ</span><a href={base + 'signals/'} class="showcase-pill showcase-pill-white">ПОДРОБНЕЕ О ПОДПИСКЕ ↗</a></div>
  </section>

  <section class="white-finale">
    <div class="showcase-section-top"><span>04 / FRENCHUG</span><span>ПРИСОЕДИНЯЙСЯ</span></div>
    <div class="finale-content"><h2>СМОТРИ<br/>НА <em>ЦИФРЫ.</em></h2><a href="https://t.me/frenchug" target="_blank" rel="noopener noreferrer" class="finale-arrow-link" aria-label="Перейти в Telegram" data-track="telegram_final">↗</a></div>
    <div class="finale-foot"><span>TELEGRAM / @FRENCHUG</span><a href="https://t.me/frenchug" target="_blank" rel="noopener noreferrer" data-track="telegram_final_text">ПЕРЕЙТИ В КАНАЛ ↗</a></div>
    <div class="mega-brand" aria-hidden="true">FRENCHUG</div>
  </section>
</div>
</Layout>
