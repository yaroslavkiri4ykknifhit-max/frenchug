---
import Layout from '../layouts/Layout.astro';
export function getStaticPaths(){return ['terms','privacy','subscription','risks'].map(legal=>({params:{legal}}));}
const key=Astro.params.legal;
const content:Record<string,{title:string;sections:{title:string;text:string}[]}>={
 terms:{title:'Условия использования',sections:[{title:'О материалах проекта',text:'Сайт рассказывает о торговом подходе FRENUGO и содержит информационные материалы. Материалы не являются персональной инвестиционной рекомендацией и не учитывают индивидуальные цели, финансовое положение или опыт посетителя.'},{title:'Самостоятельное решение',text:'Посетитель самостоятельно оценивает сведения и принимает торговые решения. Исторические результаты, если они будут опубликованы, не гарантируют будущих результатов.'},{title:'Что требует согласования',text:'До запуска продаж необходимо указать сведения об исполнителе, контакт для обращений, применимое право, порядок разрешения споров и окончательные условия оказания услуги. Эта редакция не заменяет утверждённую оферту.'}]},
 privacy:{title:'Конфиденциальность',sections:[{title:'Текущая версия сайта',text:'На сайте нет регистрации, форм сбора персональных данных, рекламных пикселей и аналитических cookies. При нажатии на ссылки Telegram посетитель переходит на сторонний сервис с собственными правилами обработки данных.'},{title:'Техническая обработка',text:'Провайдер размещения может обрабатывать технические данные запросов, необходимые для доставки страницы и защиты инфраструктуры. Перед запуском необходимо уточнить фактического провайдера, категории данных и сроки хранения.'},{title:'Перед подключением подписки',text:'Потребуется описать обработку Telegram ID, платёжных идентификаторов и статуса доступа: цели, основания, сроки хранения, получателей и порядок обращений. Платёжные реквизиты нельзя хранить в открытом репозитории.'},{title:'Что требует согласования',text:'Необходимо утвердить сведения об операторе данных и контакт для запросов, фактические интеграции, правила удаления данных и применимые требования. Сейчас сайт не принимает данные для оформления подписки.'}]},
 subscription:{title:'Условия подписки',sections:[{title:'Заявленный формат',text:'Информационные торговые сигналы в закрытом Telegram-канале. В сообщениях указываются актив, направление, условия входа, стоп-лосс, тейк-профит и параметры риска. Фиксированное количество сигналов и прибыль не обещаются.'},{title:'Стоимость и срок',text:'Заявленная стоимость — $73 за 30 дней. Бесплатного пробного периода и автоматического продления нет. Продукт предназначен для совершеннолетних. Оплата пока не подключена, оформление недоступно.'},{title:'План выдачи доступа',text:'Планируется привязка Telegram ID через технического бота и выдача доступа после подтверждённой оплаты. Доступ должен прекращаться по окончании срока или при подтверждённом полном возврате. Это описание будущей интеграции, а не действующий платёжный процесс.'},{title:'Перед открытием продаж',text:'Требуют утверждения: сведения об исполнителе, контакт поддержки, валюта фактического списания и конвертация, момент начала срока, порядок отказа и возврата, технические ограничения, допустимость платёжного сценария и окончательная оферта. Сайт не устанавливает неутверждённые ограничения возврата.'}]},
 risks:{title:'Риски торговли',sections:[{title:'Потеря капитала',text:'Стоимость криптовалют может резко меняться. Торговля может привести к частичной или полной потере выделенных средств. Прошлые результаты и результаты других участников не определяют результат твоих сделок.'},{title:'Плечо и ликвидация',text:'Кредитное плечо увеличивает чувствительность позиции к изменению цены. Возможны ликвидация и быстрый убыток. Стоп-заявки могут исполниться с проскальзыванием; указанный стоп не гарантирует максимальную величину убытка.'},{title:'Исполнение и инфраструктура',text:'Цена исполнения, комиссии, финансирование, задержки сети, ликвидность и доступность биржи влияют на результат. Сигнал может устареть до его просмотра. Возможны сбои торговой системы и ошибки программного обеспечения.'},{title:'Самостоятельная оценка',text:'Сигналы носят информационный характер. Каждый участник самостоятельно оценивает риск и пригодность сделки. Не используй для торговли средства, необходимые для обязательных расходов.'}]}
};
const page=content[key||'terms'];
---
<Layout title={`${page.title} — FRENUGO`} noindex={key!=='risks'}><article class="legal"><h1>{page.title}</h1>{key!=='risks'&&<aside class="draft-notice"><p>Предварительная редакция. Сведения об исполнителе и окончательные правила требуют согласования до открытия продаж. Сайт пока не принимает платежи.</p></aside>}{page.sections.map(section=><section><h2>{section.title}</h2><p>{section.text}</p></section>)}</article></Layout>
